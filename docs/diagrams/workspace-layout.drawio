        </mxCell>
        <mxCell id="44" value="SOURCE  App group adds 4 before the first icon, 0 after it, and 2 on both cross-axis sides." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
