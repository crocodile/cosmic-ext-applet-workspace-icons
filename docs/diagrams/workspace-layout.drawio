          <mxGeometry as="geometry" x="54.0000" y="671.0000" width="1092.0000" height="26.0000" />
        </mxCell>
        <mxCell id="46" value="CALCULATED  Icon frame is centred vertically: top = bottom = (40 - 20.8) / 2 = 9.6." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
