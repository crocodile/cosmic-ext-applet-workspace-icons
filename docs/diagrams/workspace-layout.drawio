        <mxCell id="39" value="SOURCE  Background and content are separate layers. Insets and outline widths do not add content padding." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
