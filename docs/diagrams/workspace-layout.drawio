        <mxCell id="43" value="SOURCE  Button padding = 0. Content edges = 8 each; number/divider/app-group gaps = 4 each." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
