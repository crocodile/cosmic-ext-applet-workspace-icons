        </mxCell>
        <mxCell id="40" value="SOURCE  Border setting = 0..3 (default 2); hovered outlines become filled with no border, except urgent." style="text;html=0;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#172B4D;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
